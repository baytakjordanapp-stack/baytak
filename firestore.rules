rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // المدير = وثيقة باسم uid بمجموعة admins (تنشئها يدوياً من لوحة Firebase)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validListing(d) {
      return d.keys().hasOnly(['ownerId', 'ownerName', 'type', 'kind', 'city', 'area', 'price', 'rooms',
                               'baths', 'size', 'furnished', 'phone', 'map', 'desc', 'photos', 'status',
                               'createdAt', 'expiresAt'])
        && d.ownerId == request.auth.uid
        && d.ownerName is string && d.ownerName.size() <= 80
        && d.type in ['rent', 'sale']
        && d.kind in ['شقة', 'بيت مستقل', 'فيلا', 'دوبلكس', 'استوديو', 'طابق أرضي']
        && d.city is string && d.city.size() >= 2 && d.city.size() <= 30
        && d.area is string && d.area.size() >= 2 && d.area.size() <= 60
        && d.price is number && d.price > 0 && d.price <= 50000000
        && d.rooms is int && d.rooms >= 0 && d.rooms <= 20
        && d.baths is int && d.baths >= 0 && d.baths <= 10
        && d['size'] is int && d['size'] >= 0 && d['size'] <= 100000
        && d.furnished is bool
        && d.phone is string && d.phone.matches('^07[789][0-9]{7}$')
        && d.map is string && d.map.size() <= 500
        && d.desc is string && d.desc.size() <= 600
        && d.photos is list && d.photos.size() <= 8
        && d.status == 'active'
        && d.createdAt == request.time
        && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(61, 'd');
    }

    match /listings/{listingId} {
      // الكل بيقرأ الإعلانات الفعالة. صاحب الإعلان والمدير بيقرؤوا الباقي.
      allow read: if resource.data.status == 'active'
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn() && validListing(request.resource.data);

      // صاحب الإعلان بيغيّر الحالة (فعّال/منتهي) أو بيجدّد المدة فقط، وما بيقدر يرجّع إعلان أخفاه المدير.
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && resource.data.status != 'hidden'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiresAt'])
          && request.resource.data.status in ['active', 'done']
          && request.resource.data.expiresAt <= request.time + duration.value(61, 'd'))
        || isAdmin()
      );

      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['listingId', 'reporterId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.listingId is string && request.resource.data.listingId.size() <= 40
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
